# Copy to .env for local runs (.env is gitignored). On a host, set these in
# the platform's environment settings instead. NEVER put real values in git.

# ---- required everywhere ----
# The model. Whyzr uses anthropic:claude-sonnet-4-5-20250929 (see agent.yaml).
ANTHROPIC_API_KEY=

# ---- hosted app (server/app.mjs) ----
# The access code testers type once per device. Minimum 6 characters.
# The app REFUSES TO START without it: an unset or empty code used to mean
# "serve with no gate", which is the wrong default for a children's app.
WHYZR_CODE=

# Local development only: run with no access code at all. Never set on a host.
# WHYZR_OPEN_DEV=1

# Gates the /api/admin/* endpoints that `npm run review` reads.
ADMIN_KEY=

# Where kid repos, the registry and transcripts live. Must be a persistent
# volume in production. Everything here is outside every git repo.
# WHYZR_DATA_DIR=/data

# ---- cost armor ----
# Global ceiling for a day. At this figure the app enters kid-safe nap mode.
DAILY_BUDGET_USD=1
# MAX_TURNS_PER_SESSION=30
# MAX_SESSIONS_PER_DAY=3
# MAX_DAILY_TOKENS=400000
# MAX_KIDS=1

# ---- deployment ----
# How many trusted proxies sit in front of the app. X-Forwarded-For is
# client-controlled, so it is ignored unless this is set. Railway and Fly
# both put exactly one proxy in front: use 1.
# TRUST_PROXY_HOPS=1
# PORT=3456

# ---- testing only ----
# Saves full conversation transcripts to the volume for tuning RULES.md.
# Turn OFF and delete the transcript directory before any public launch, so
# the "raw conversations are not kept" claim stays true.
# SAVE_TRANSCRIPTS=true
